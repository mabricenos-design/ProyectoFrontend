.productos-encabezado {
    text-align: center;
    margin: 50px auto 40px;
    max-width: 700px;
}

.productos-encabezado span {
    color: #a16207;
    font-size: 13px;
    font-weight: bold;
    letter-spacing: 2px;
}

.productos-encabezado h2 {
    font-size: 40px;
    color: #292524;
    margin: 8px 0 10px;
}

.productos-encabezado p {
    color: #78716c;
    font-size: 16px;
}




.catalogo {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 25px;
    margin-bottom: 50px;
}



.catalogo-card {
    background-color: white;
    display: flex;
    flex-direction: column;
}

.catalogo-card .producto-icono {
    height: 190px;
    background: linear-gradient(
        135deg,
        #e7e5e4,
        #d6d3d1
    );

    font-size: 75px;
}



.catalogo-card .producto-contenido {
    padding: 24px;
    display: flex;
    flex-direction: column;
    flex: 1;
}

.catalogo-card h3 {
    min-height: 48px;
}

.catalogo-card p {
    min-height: 45px;
}



.datos-producto {
    display: flex;
    justify-content: space-between;
    gap: 10px;

    padding: 12px 0;
    margin-bottom: 10px;

    border-top: 1px solid #e7e5e4;
    border-bottom: 1px solid #e7e5e4;

    color: #78716c;
    font-size: 13px;
}

.datos-producto strong {
    color: #292524;
}




.stock-disponible {
    color: #57534e;
}




.boton-producto {
    width: 100%;

    padding: 12px;

    border: none;
    border-radius: 7px;

    background-color: #292524;
    color: white;

    font-family: Arial, Helvetica, sans-serif;
    font-size: 14px;
    font-weight: bold;

    cursor: pointer;

    transition: 0.3s;
}

.boton-producto:hover {
    background-color: #a16207;
    transform: translateY(-2px);

    box-shadow:
        0 6px 15px rgba(0, 0, 0, 0.12);
}

.boton-producto:active {
    transform: translateY(0);
}



@media (max-width: 950px) {

    .catalogo {
        grid-template-columns: repeat(2, 1fr);
    }

}


@media (max-width: 650px) {

    .productos-encabezado {
        margin-top: 35px;
    }

    .productos-encabezado h2 {
        font-size: 32px;
    }

    .catalogo {
        grid-template-columns: 1fr;
    }

}

