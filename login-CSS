.login {
    max-width: 520px;
    margin: 55px auto;
    background-color: white;
    padding: 45px;
    border-radius: 18px;
    border: 1px solid #e7e5e4;
    box-shadow: 0 12px 35px rgba(0, 0, 0, 0.08);
}


.login-encabezado {
    text-align: center;
    margin-bottom: 30px;
}

.login-icono {
    width: 78px;
    height: 78px;

    margin: 0 auto 18px;

    display: flex;
    align-items: center;
    justify-content: center;

    background-color: #e7e5e4;
    border-radius: 50%;

    font-size: 35px;

    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.06);
}

.login-etiqueta {
    color: #a16207;
    font-size: 12px;
    font-weight: bold;
    letter-spacing: 2px;
}

.login h2 {
    font-size: 34px;
    color: #292524;
    margin: 8px 0 10px;
}

.login-descripcion {
    color: #78716c;
    font-size: 15px;
    line-height: 1.6;
}



.campo-login {
    margin-bottom: 20px;
}

.campo-login label {
    display: block;
    color: #292524;
    font-weight: bold;
    font-size: 14px;
    margin-bottom: 8px;
}

.campo-login input {
    width: 100%;
    padding: 14px 15px;

    border: 1px solid #d6d3d1;
    border-radius: 8px;

    background-color: #fafaf9;

    font-family: Arial, Helvetica, sans-serif;
    font-size: 15px;

    transition: 0.3s;
}

.campo-login input::placeholder {
    color: #a8a29e;
}

.campo-login input:focus {
    outline: none;

    background-color: white;

    border-color: #a16207;

    box-shadow:
        0 0 0 3px rgba(161, 98, 7, 0.10);
}



.login-opciones {
    display: flex;
    justify-content: space-between;
    align-items: center;

    margin: 5px 0 25px;

    font-size: 13px;
}

.recordar {
    display: flex;
    align-items: center;
    gap: 7px;

    color: #57534e;
    cursor: pointer;
}

.recordar input {
    accent-color: #a16207;
    cursor: pointer;
}

.login-opciones a {
    color: #a16207;
    text-decoration: none;
    font-weight: bold;
}

.login-opciones a:hover {
    text-decoration: underline;
}


.boton-login {
    width: 100%;

    padding: 14px;

    border: none;
    border-radius: 8px;

    background-color: #292524;
    color: white;

    font-family: Arial, Helvetica, sans-serif;
    font-size: 16px;
    font-weight: bold;

    cursor: pointer;

    transition: 0.3s;
}

.boton-login:hover {
    background-color: #57534e;
    transform: translateY(-2px);

    box-shadow:
        0 7px 18px rgba(0, 0, 0, 0.15);
}

.boton-login:active {
    transform: translateY(0);
}



#mensajeLogin {
    min-height: 20px;

    margin-top: 15px;

    text-align: center;

    font-size: 14px;
    font-weight: bold;
}



.login-registro {
    text-align: center;

    margin-top: 30px;
    padding-top: 25px;

    border-top: 1px solid #e7e5e4;
}

.login-registro p {
    color: #78716c;

    font-size: 14px;

    margin-bottom: 7px;
}

.login-registro a {
    color: #a16207;

    text-decoration: none;

    font-size: 15px;
    font-weight: bold;
}

.login-registro a:hover {
    text-decoration: underline;
}



@media (max-width: 600px) {

    .login {
        width: 95%;

        margin: 30px auto;

        padding: 35px 25px;
    }

    .login h2 {
        font-size: 28px;
    }

    .login-opciones {
        flex-direction: column;
        align-items: flex-start;

        gap: 12px;
    }

}
