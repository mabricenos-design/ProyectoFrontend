

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    background-color: #f7f5f3;
    color: #292524;
    line-height: 1.6;
}



header {
    background-color: #1c1917;
    color: white;
    padding: 28px 20px;
    text-align: center;
}

.logo h1 {
    font-size: 36px;
    letter-spacing: 2px;
    margin-bottom: 5px;
}

.logo p {
    color: #d6d3d1;
    font-size: 15px;
}


nav {
    background-color: #292524;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 10px;
    padding: 14px 20px;
    flex-wrap: wrap;
}

nav a {
    color: white;
    text-decoration: none;
    font-weight: bold;
    padding: 10px 18px;
    border-radius: 6px;
    transition: 0.3s;
}

nav a:hover {
    background-color: #57534e;
}



main {
    width: 90%;
    max-width: 1200px;
    margin: 35px auto;
}


.hero {
    background: linear-gradient(
        135deg,
        #292524,
        #57534e
    );

    color: white;

    min-height: 400px;

    border-radius: 15px;

    display: flex;
    align-items: center;

    padding: 60px;

    margin-bottom: 40px;

    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.12);
}

.hero-contenido {
    max-width: 650px;
}

.etiqueta {
    display: inline-block;

    background-color: #d6a77a;

    color: #292524;

    font-size: 13px;

    font-weight: bold;

    padding: 7px 14px;

    border-radius: 20px;

    margin-bottom: 18px;
}

.hero h2 {
    font-size: 52px;
    line-height: 1.1;
    margin-bottom: 20px;
}

.hero p {
    font-size: 18px;
    color: #e7e5e4;
    margin-bottom: 30px;
    max-width: 600px;
}



.boton {
    display: inline-block;

    background-color: #d6a77a;

    color: #292524;

    text-decoration: none;

    font-weight: bold;

    padding: 13px 25px;

    border-radius: 7px;

    transition: 0.3s;
}

.boton:hover {
    background-color: #e5c19f;

    transform: translateY(-2px);
}



.destacados {
    background-color: white;

    padding: 40px;

    border-radius: 15px;

    margin-bottom: 40px;

    box-shadow: 0 5px 20px rgba(0, 0, 0, 0.06);
}

.titulo-seccion {
    text-align: center;

    margin-bottom: 35px;
}

.titulo-seccion span {
    color: #a16207;

    font-size: 13px;

    font-weight: bold;

    letter-spacing: 2px;
}

.titulo-seccion h2 {
    font-size: 32px;

    margin: 8px 0;
}

.titulo-seccion p {
    color: #78716c;
}



.productos-grid {
    display: grid;

    grid-template-columns: repeat(2, 1fr);

    gap: 25px;
}



.producto-card {
    background-color: #fafaf9;

    border: 1px solid #e7e5e4;

    border-radius: 12px;

    overflow: hidden;

    transition: 0.3s;
}

.producto-card:hover {
    transform: translateY(-5px);

    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.10);
}

.producto-icono {
    height: 150px;

    background-color: #e7e5e4;

    display: flex;

    justify-content: center;

    align-items: center;

    font-size: 65px;
}

.producto-contenido {
    padding: 22px;
}

.categoria {
    font-size: 12px;

    color: #a16207;

    font-weight: bold;

    letter-spacing: 1px;
}

.producto-contenido h3 {
    font-size: 20px;

    margin: 7px 0 10px;
}

.producto-contenido p {
    color: #78716c;

    font-size: 14px;

    margin-bottom: 18px;
}


.producto-info {
    display: flex;

    justify-content: space-between;

    align-items: center;

    margin-bottom: 18px;
}

.producto-info strong {
    font-size: 21px;

    color: #292524;
}

.producto-info span {
    font-size: 13px;

    color: #57534e;
}


.boton-secundario {
    display: block;

    text-align: center;

    background-color: #292524;

    color: white;

    text-decoration: none;

    padding: 10px;

    border-radius: 6px;

    font-weight: bold;

    transition: 0.3s;
}

.boton-secundario:hover {
    background-color: #57534e;
}


.informacion {
    display: grid;

    grid-template-columns: repeat(3, 1fr);

    gap: 25px;

    margin-bottom: 40px;
}

.informacion article {
    background-color: white;

    padding: 30px;

    border-radius: 12px;

    text-align: center;

    border: 1px solid #e7e5e4;
}

.info-icono {
    font-size: 40px;

    margin-bottom: 12px;
}

.informacion h3 {
    margin-bottom: 10px;
}

.informacion p {
    color: #78716c;

    font-size: 14px;
}



footer {
    background-color: #1c1917;

    color: white;

    margin-top: 50px;
}

.footer-contenido {
    width: 90%;

    max-width: 1200px;

    margin: auto;

    padding: 45px 0;

    display: grid;

    grid-template-columns: 2fr 1fr 1fr;

    gap: 40px;
}

.footer-contenido h3 {
    margin-bottom: 12px;
}

.footer-contenido p {
    color: #d6d3d1;

    font-size: 14px;

    margin-bottom: 5px;
}

.footer-contenido a {
    color: #d6a77a;

    text-decoration: none;
}

.footer-contenido a:hover {
    text-decoration: underline;
}

.footer-final {
    border-top: 1px solid #44403c;

    text-align: center;

    padding: 18px;

    color: #a8a29e;

    font-size: 13px;
}


@media (max-width: 768px) {

    .hero {
        padding: 40px 25px;

        min-height: 350px;
    }

    .hero h2 {
        font-size: 38px;
    }

    .productos-grid {
        grid-template-columns: 1fr;
    }

    .informacion {
        grid-template-columns: 1fr;
    }

    .footer-contenido {
        grid-template-columns: 1fr;

        text-align: center;
    }

    nav {
        flex-direction: column;
    }

    nav a {
        width: 100%;

        text-align: center;
    }
}
